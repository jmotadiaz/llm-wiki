{
  "name": "llm-wiki",
  "version": "1.0.0",
  "description": "Personal knowledge base compiled from raw sources with LLM",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "build:fresh": "pnpm -r build:fresh",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @llm-wiki/server start"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
